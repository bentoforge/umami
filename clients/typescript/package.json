{
  "name": "@bentoforge/umami-iam",
  "version": "0.1.0",
  "description": "Typed client SDK for the umami micro-IAM service",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "keywords": [
    "iam",
    "auth",
    "jwt",
    "oidc",
    "multi-tenant",
    "umami"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bentoforge/umami.git",
    "directory": "clients/typescript"
  },
  "homepage": "https://github.com/bentoforge/umami#readme",
  "bugs": "https://github.com/bentoforge/umami/issues",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "lint": "biome check",
    "format": "biome check --write"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "typescript": "^5.6.0"
  }
}
