# ── wasabi core ──────────────────────────────────────────────────────────────
APP_NAME=umami
BIND_ADDRESS=127.0.0.1:8090
DYNAMO_TABLE_PREFIX=umami-dev
# `warp::filters::trace=error` drops warp's per-request 4xx "unable to serve request (client error)"
# WARNs (expected client errors like a 401 on the silent-refresh probe) while keeping 5xx at ERROR.
RUST_LOG=warn,umami=debug,wasabi=debug,warp::filters::trace=error
# Dev testing uses the shared dbx-dev AWS account/profile; umami's own tables are
# isolated by the DYNAMO_TABLE_PREFIX above.
AWS_PROFILE=dbx-dev
# Trust the X-Forwarded-For header for the client IP recorded on sessions/audit. Leave unset (or
# false) when umami is directly exposed — otherwise a client can spoof its IP. Enable ONLY behind
# exactly one trusted reverse proxy / load balancer (e.g. an ALB) that appends the real client
# address; the rightmost XFF entry is then used. Truthy values: 1/true/yes/on.
# TRUST_FORWARDED_FOR=true
# Comma-separated exact origins allowed to call umami cross-origin WITH the refresh cookie
# (credentialed CORS forbids `*`, so this is an explicit allow-list). Needed only when a separate
# SPA — typically a same-site subdomain like https://spa.myapp.com talking to https://iam.myapp.com —
# calls umami; the bundled UI is same-origin and needs none. The SPA must fetch with
# `credentials: "include"`. Unset = no CORS headers (default).
# CORS_ALLOWED_ORIGINS=https://spa.myapp.com,https://admin.myapp.com

# ── wasabi auth (umami guards its OWN admin routes with a trusted issuer) ──────
# For local dev umami can trust itself: point AUTH_ISSUER at UMAMI_ISSUER via JWKS.
AUTH_ISSUER=http://localhost:8090/=jwks:/.well-known/jwks.json
AUTH_ALGORITHMS=ES256
# AUTH_AUDIENCE=umami

# ── umami token issuance ──────────────────────────────────────────────────────
UMAMI_ISSUER=http://localhost:8090/
# Active signing key as a PRIVATE EC P-256 JWK (JSON, single line, must include a "kid"). Signs the
# ES256 access tokens; its public half is published in the JWKS. For local dev only; in prod load
# from KMS/SSM/Secrets Manager. Generate one e.g. with step-cli:
#   step crypto jwk create pub.jwk key.jwk --kty EC --crv P-256 --kid dev-1 --use sig \
#        --insecure --no-password   # then paste the contents of key.jwk below
UMAMI_SIGNING_KEY=
# Key rotation: the retiring key's PUBLIC JWK(s) as a JSON array, kept in the JWKS so tokens signed
# by the just-rotated-out key still verify until they expire. Copy the entry straight from the live
# /.well-known/jwks.json before rotating. Optional; unset = only the active key is published.
# UMAMI_PREVIOUS_KEYS=[{"kty":"EC","crv":"P-256","kid":"old-1","x":"…","y":"…","alg":"ES256","use":"sig"}]
# Access/refresh token lifetimes + min password length come from the config `security` settings
# (see docs/CONFIG.md), not env.
UMAMI_COOKIE_DOMAIN=localhost
UMAMI_DEFAULT_AUDIENCE=umami
# Key for encrypting MFA (TOTP) secrets at rest — base64 of 32 random bytes.
# Generate with: openssl rand -base64 32
UMAMI_MFA_KEY=
# WebAuthn relying party: the effective RP id (registrable domain) + the site origin.
UMAMI_WEBAUTHN_RP_ID=localhost
UMAMI_WEBAUTHN_ORIGIN=http://localhost:8093

# ── config catalog ──────────────────────────────────────────────────────────
# Config persists in S3 whenever an S3 client is available the wasabi way — i.e. S3_BUCKET_SUFFIX is
# set. The bucket is fixed at "config.<S3_BUCKET_SUFFIX>" (like DynamoDB tables get a fixed name plus
# the shared deployment prefix); umami auto-creates it on first boot, enables versioning, and seeds a
# default config.json. WITHOUT S3_BUCKET_SUFFIX the config is in-memory only — edits are LOST on
# restart (dev fallback).
# S3_BUCKET_SUFFIX=dev.example.com          # set this to enable S3-persisted config
# UMAMI_CONFIG_KEY=umami/config.json         # optional object key (default shown)
# Optional noncurrent-version retention (needs s3:PutLifecycleConfiguration). Unset → keep all.
# UMAMI_CONFIG_VERSIONS_KEEP=20              # keep the newest N superseded versions
# UMAMI_CONFIG_VERSIONS_EXPIRE_DAYS=365      # expire noncurrent versions after N days

# ── system tenant + bootstrap ─────────────────────────────────────────────────
# Members of this tenant get the synthetic `is:system-tenant` marker, which the config maps to
# `manage:tenants` + `switch:tenant` (cross-tenant admin: GET/POST/DELETE /tenants, feature
# grant/revoke, switch-tenant). Unset → nobody holds those permissions, so those routes are locked.
# UMAMI_SYSTEM_TENANT_ID=
#
# On an empty deployment (0 tenants), UMAMI_AUTO_INIT=true bootstraps a system tenant (with the id
# above when set, otherwise a generated one) + an owner user with a RANDOMLY GENERATED one-time
# password. The tenant id, username and password are printed ONCE to the log at startup — grab them
# there, sign in, and change the password immediately. Username defaults to `root`.
UMAMI_AUTO_INIT=false
# UMAMI_ROOT_USERNAME=root

# ── DynamoDB TTL (operational, no env) ─────────────────────────────────────────
# umami writes a numeric `ttl` attribute on two tables so DynamoDB can self-clean expired rows, but
# it does NOT enable the table TTL itself (that's an account/table setting, like backups). Enable it
# ONCE per deployment, out-of-band (Terraform/console), on BOTH tables, attribute name `ttl`:
#   <DYNAMO_TABLE_PREFIX>-sessions    → drops expired login sessions
#   <DYNAMO_TABLE_PREFIX>-audit-log   → drops audit entries past their retention
# Without it the rows never expire (they still work; the table just grows).

# ── audit log ─────────────────────────────────────────────────────────────────
# Days an audit entry is kept before its `ttl` lets DynamoDB expire it (see TTL note above).
# Default 365.
# UMAMI_AUDIT_RETENTION_DAYS=365

# ── management UI (optional) ───────────────────────────────────────────────────
# umami can serve the built management SPA itself, under /app (/, plus a client-router fallback).
# Point this at a built `dist` directory (containing index.html + assets/). Unset → defaults to
# clients/ui/dist (handy for local dev); if that directory has no index.html the UI is simply not
# mounted and umami runs API-only. In a container, e.g. COPY the build to /app/ui and set this.
# The URL mount (/app) is fixed (must match the UI's Vite `base`); only the file location is env.
# UMAMI_UI_DIR=clients/ui/dist
